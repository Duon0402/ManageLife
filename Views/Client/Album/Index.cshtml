@{
	ViewData["Title"] = "Photo Albums";
}

<style>
	.album-gallery-container {
		padding: 20px 0;
	}

	.album-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 24px;
	}

	.album-header h2 {
		font-weight: 700;
		color: #2c3e50;
		margin: 0;
	}

	.btn-create-album {
		background-color: #5145ba;
		color: white;
		border: none;
		border-radius: 8px;
		padding: 10px 20px;
		font-weight: 600;
		transition: background-color 0.2s, transform 0.1s;
		box-shadow: 0 4px 6px rgba(81, 69, 186, 0.2);
	}

	.btn-create-album:hover {
		background-color: #42379b;
		color: white;
		transform: translateY(-1px);
	}

	.album-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 24px;
	}

	.album-card {
		background: #fff;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: 0 4px 15px rgba(0,0,0,0.05);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		cursor: pointer;
		position: relative;
		display: flex;
		flex-direction: column;
		height: 280px;
		text-decoration: none;
		border: 1px solid #eaeaea;
	}

	.album-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 12px 25px rgba(0,0,0,0.1);
	}

	.album-card:hover .album-overlay {
		opacity: 1;
	}

	.album-cover {
		height: 180px;
		background-color: #f8f9fa;
		background-size: cover;
		background-position: center;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.album-cover.empty {
		background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
	}

	.album-cover.empty i {
		font-size: 3rem;
		color: #a0aec0;
	}

	.album-info {
		padding: 16px;
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background: white;
	}

	.album-title {
		font-size: 1.1rem;
		font-weight: 700;
		color: #2d3748;
		margin-bottom: 4px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.album-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0,0,0,0.4);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 15px;
		opacity: 0;
		transition: opacity 0.3s ease;
		z-index: 2;
	}

	.btn-album-action {
		width: 45px;
		height: 45px;
		border-radius: 50%;
		border: none;
		display: flex;
		align-items: center;
		justify-content: center;
		color: white;
		font-size: 1.2rem;
		transition: transform 0.2s, background-color 0.2s;
		box-shadow: 0 4px 10px rgba(0,0,0,0.3);
		text-decoration: none !important;
	}

	.btn-album-action:hover {
		transform: scale(1.1);
		color: white;
	}

	.btn-album-view {
		background-color: #5145ba;
	}

	.btn-album-add {
		background-color: #28a745;
	}

	.album-meta {
		font-size: 0.85rem;
		color: #718096;
		display: flex;
		align-items: center;
		gap: 6px;
	}

	/* Empty state */
	.empty-state {
		text-align: center;
		padding: 60px 20px;
		background: #f8f9fa;
		border-radius: 12px;
		border: 2px dashed #e2e8f0;
		color: #a0aec0;
	}

	.empty-state i {
		font-size: 4rem;
		margin-bottom: 16px;
	}

	.empty-state h4 {
		color: #4a5568;
		font-weight: 600;
	}
</style>

<div class="container mt-4 album-gallery-container">
	<div id="album-index-container"></div>
</div>

<script>
    $(function () {
        new App.AlbumIndexPage("#album-index-container");
    });
</script>
