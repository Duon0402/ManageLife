@model ManageLife.Entities.AlbumEntity
@{
	ViewData["Title"] = Model?.Title ?? "Album Details";
}

<style>
	.album-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 24px;
	}

	.album-title-section h2 {
		font-weight: 700;
		color: #2c3e50;
		margin: 0 0 8px 0;
	}

	.album-description {
		color: #6c757d;
		font-size: 1rem;
		max-width: 600px;
	}

	.btn-upload-photo {
		background-color: #5145ba;
		color: white;
		border: none;
		border-radius: 8px;
		padding: 10px 20px;
		font-weight: 600;
		transition: background-color 0.2s, transform 0.1s;
		box-shadow: 0 4px 6px rgba(81, 69, 186, 0.2);
	}

	.btn-upload-photo:hover {
		background-color: #42379b;
		color: white;
		transform: translateY(-1px);
	}

	.photo-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 16px;
	}

	.photo-card {
		position: relative;
		border-radius: 12px;
		overflow: hidden;
		aspect-ratio: 1 / 1;
		background: #f8f9fa;
		box-shadow: 0 4px 10px rgba(0,0,0,0.05);
		transition: transform 0.3s ease;
		cursor: pointer;
	}

	.photo-card:hover {
		transform: scale(1.03);
		z-index: 10;
		box-shadow: 0 8px 20px rgba(0,0,0,0.15);
	}

	.photo-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

    .photo-actions {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
        padding: 10px;
        display: flex;
        justify-content: flex-end;
        opacity: 0;
        transition: opacity 0.2s;
    }

    .photo-card:hover .photo-actions {
        opacity: 1;
    }

    .btn-set-cover {
        color: white;
        background: transparent;
        border: none;
        padding: 5px;
    }

    .btn-set-cover:hover {
        color: #ffc107;
    }

    .btn-delete-photo {
        color: white;
        background: transparent;
        border: none;
        padding: 5px;
    }

    .btn-delete-photo:hover {
        color: #dc3545;
    }

	/* Empty state */
	.empty-state {
		text-align: center;
		padding: 60px 20px;
		background: #f8f9fa;
		border-radius: 12px;
		border: 2px dashed #e2e8f0;
		color: #a0aec0;
		grid-column: 1 / -1;
	}

	.empty-state i {
		font-size: 4rem;
		margin-bottom: 16px;
	}

	.empty-state h4 {
		color: #4a5568;
		font-weight: 600;
	}
</style>

<div class="container mt-4 album-details-container">
	<div id="album-details-app" data-id="@Model?.Id">
        <div class="album-header">
            <div class="album-title-section">
                <a href="/Album" class="btn btn-link text-decoration-none p-0 mb-3 text-muted"><i class="fas fa-arrow-left"></i> Back to Albums</a>
                <h2>@Model?.Title</h2>
                @if (!string.IsNullOrEmpty(Model?.Description))
                {
                    <p class="album-description">@Model?.Description</p>
                }
            </div>
            <button class="btn-upload-photo" id="btnUploadPhoto">
                <i class="fas fa-upload mr-2"></i> Upload Photos
            </button>
        </div>

        <div class="photo-grid" id="photoGrid">
            <!-- Photos will be loaded here via JS -->
        </div>
    </div>
</div>

<script>
    $(function () {
        const albumId = $('#album-details-app').data('id');
        new App.AlbumDetailsPage("#album-details-app", albumId);
    });
</script>
