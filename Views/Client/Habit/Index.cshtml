@{
    Options.Title = "Thói quen";
}

<div class="habit-page" id="habit-page">

    <div class="habit-header">
        <h1><i class="fa-solid fa-repeat"></i> Thói quen</h1>
        <button class="habit-btn-primary" id="btn-create-habit">
            <i class="fa-solid fa-plus"></i> Thêm thói quen
        </button>
    </div>

    <div class="habit-card">
        <table class="habit-table">
            <thead>
                <tr>
                    <th>Tên thói quen</th>
                    <th>Mô tả</th>
                    <th class="text-center">Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="habit-tbody">
                <tr id="habit-loading-row">
                    <td colspan="5" class="text-center py-4 text-muted">
                        <i class="fa-solid fa-spinner fa-spin me-2"></i>Đang tải...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</div>

<!-- Modal tạo / chỉnh sửa habit -->
<div class="modal fade" id="modal-habit" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-habit-title">
                    <i class="fa-solid fa-repeat me-2"></i>Thêm thói quen
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="habit-id" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên thói quen <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="habit-name" maxlength="200" placeholder="Ví dụ: Đọc sách 30 phút mỗi ngày" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mô tả</label>
                    <textarea class="form-control" id="habit-description" rows="3" maxlength="500"
                              placeholder="Ghi chú thêm (tùy chọn)"></textarea>
                </div>
                <div class="mb-3" id="habit-active-wrap" style="display:none">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="habit-is-active" checked />
                        <label class="form-check-label" for="habit-is-active">Đang hoạt động</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm" id="btn-save-habit">
                    <i class="fa-solid fa-check me-1"></i>Lưu
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .habit-page { padding: 1.75rem 2rem; }

    .habit-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .habit-header h1 {
        font-size: 1.2rem;
        font-weight: 700;
        color: #2c2c54;
        margin: 0;
    }

    .habit-header h1 i { color: #4b49ac; }

    .habit-btn-primary {
        background: #4b49ac;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.55rem 1.1rem;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: background 0.2s;
    }

    .habit-btn-primary:hover { background: #3d3c8e; }

    .habit-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #e8eaf0;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .habit-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }

    .habit-table thead tr { background: #f5f7ff; border-bottom: 2px solid #e8eaf0; }

    .habit-table th {
        padding: 0.75rem 1rem;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: #9ea5b5;
        white-space: nowrap;
    }

    .habit-table td { padding: 0.75rem 1rem; border-bottom: 1px solid #f0f1f7; vertical-align: middle; }

    .habit-table tbody tr:last-child td { border-bottom: none; }

    .habit-table tbody tr:hover { background: #fafbff; }

    .habit-name { font-weight: 600; color: #2c2c54; }

    .habit-desc { color: #777; font-size: 0.82rem; max-width: 300px; }

    .habit-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        border-radius: 20px;
        padding: 0.2rem 0.65rem;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .habit-badge.active { background: #e8f8f0; color: #27ae60; }
    .habit-badge.inactive { background: #f5f5f5; color: #aaa; }

    .habit-actions { display: flex; gap: 0.4rem; justify-content: flex-end; }

    .habit-btn-icon {
        border: none;
        background: transparent;
        border-radius: 6px;
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.8rem;
        transition: background 0.15s;
    }

    .habit-btn-icon.edit { color: #4b49ac; }
    .habit-btn-icon.edit:hover { background: #eeeeff; }
    .habit-btn-icon.delete { color: #e74c3c; }
    .habit-btn-icon.delete:hover { background: #fff0f0; }
</style>

<script>
    $(function () {
        new App.HabitPage('#habit-page');
    });
</script>
