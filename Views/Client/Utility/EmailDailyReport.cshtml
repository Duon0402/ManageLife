@{
    Options.Title = "Generate Email Daily Report";

    const string PlaceholderToday = @"- Liệt kê các công việc đã làm, kết quả/tiến độ, lý do chưa hoàn thành. Mã task trên Jira nếu có
- Ứng dụng AI: bắt buộc với nhóm lập trình — ghi cụ thể việc; với QA/ Triển khai: khuyến khích";

    const string PlaceholderTomorrow = @"- Liệt kê công việc sẽ làm. Mã task Jira nếu có. Nêu rõ yêu cầu hỗ trợ từ nhân sự khác nếu cần
- Ứng dụng AI: dự kiến";

    const string PlaceholderSuggestion = "- Các ý kiến đề xuất nếu có. Nếu không có ghi rõ \"Không có\"";
}


<div class="container my-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold">Generate Email Daily Report</h2>
    </div>

    <!-- Input Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Nhập nội dung báo cáo</h5>

            <!-- I. Kết quả công việc hôm nay -->
            <div class="mb-3">
                <label class="form-label fw-bold">I. Kết quả công việc hôm nay <span class="text-danger">*</span></label>
                <textarea id="txtTodayResult"
                          class="form-control"
                          rows="4"
                          placeholder="@PlaceholderToday"></textarea>
            </div>

            <!-- II. Dự kiến công việc ngày mai -->
            <div class="mb-3">
                <label class="form-label fw-bold">II. Dự kiến công việc ngày mai <span class="text-danger">*</span></label>
                <textarea id="txtTomorrowPlan"
                          class="form-control"
                          rows="4"
                          placeholder="@PlaceholderTomorrow"></textarea>
            </div>

            <!-- III. Ý kiến đề xuất -->
            <div class="mb-3">
                <label class="form-label fw-bold">III. Ý kiến đề xuất</label>
                <textarea id="txtSuggestion"
                          class="form-control"
                          rows="3"
                          placeholder="@PlaceholderSuggestion"></textarea>
            </div>

            <div class="text-end">
                <button id="btnGenerate" class="btn btn-primary btn-lg px-4">
                    Generate
                </button>
            </div>
        </div>
    </div>

    <!-- Result -->
    <div id="result" class="d-none mt-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">

                <!-- Email To -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Email To</label>
                    <div class="input-group">
                        <input id="txtEmailTo" class="form-control" readonly />
                        <button class="btn btn-outline-secondary btn-sm" onclick="copyField('#txtEmailTo')">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>

                <!-- Email CC -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Email CC</label>
                    <div class="input-group">
                        <input id="txtEmailCc" class="form-control" readonly />
                        <button class="btn btn-outline-secondary btn-sm" onclick="copyField('#txtEmailCc')">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>

                <!-- Subject -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Subject</label>
                    <div class="input-group">
                        <input id="txtSubject" class="form-control" readonly />
                        <button class="btn btn-outline-secondary btn-sm" onclick="copyField('#txtSubject')">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>

                <!-- Body -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Body</label>
                    <div class="input-group">
                        <textarea id="txtBody" class="form-control" rows="8" readonly></textarea>
                        <button class="btn btn-outline-secondary btn-sm" onclick="copyField('#txtBody')">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    $("#btnGenerate").click(async function () {

        const todayResult = $("#txtTodayResult").val().trim();
        const tomorrowPlan = $("#txtTomorrowPlan").val().trim();
        const suggestion = $("#txtSuggestion").val().trim();

        const req = {
            todayResult,
            tomorrowPlan,
            suggestion
        };

        const rs = await ajaxService.post('/Utility/GenerateEmailDailyReport', req, {
            showToast: true,
            onSuccess: function (res) {
                if (res.isOk()) {
                    const data = res.data;

                    $("#txtSubject").val(data.subject ?? "");
                    $("#txtBody").val(data.body ?? "");
                    $("#txtEmailTo").val(data.emailTo ?? "");
                    $("#txtEmailCc").val(data.emailCc ?? "");

                    $("#result").removeClass("d-none");
                    window.scrollTo({ top: $("#result").offset().top - 100, behavior: "smooth" });
                }
                else {
                    showToast(res.message || 'Error', 'Thông báo', 'error');
                }
            }
        });
    });

    function copyField(selector) {
        const text = $(selector).val();
        navigator.clipboard.writeText(text)
            .then(() => showToast('Copy thành công!', 'Thông báo', 'success'))
            .catch(() => showToast('Copy thất bại!', 'Thông báo', 'error'));
    }
</script>

<style>
    #result .card {
        border-radius: 12px;
        border: 1px solid #dee2e6;
    }

    .input-group .btn-sm {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        padding: 0.25rem;
    }

    .input-group .form-control[readonly] {
        background-color: #f8f9fa;
        cursor: not-allowed;
    }
</style>
