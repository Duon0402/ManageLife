@{
    Options.Title = "Daily Report Email";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-4 col-12 mb-lg-0 mb-3">
            <div class="card my-3 h-100">
                <div class="card-body">
                    <div class="card-title mb-3 pb-2 border-1 border-bottom">
                        <h4 class="text-center">Enter your report here</h4>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 col-12 mb-3">
                            <label for="currentBusinessDay" class="form-label">Current Business Day <span class="text-danger">*</span></label>
                            <input type="text" class="form-control datepicker" id="currentBusinessDay" style="padding: 6px 12px !important;" required>
                        </div>
                        <div class="col-lg-6 col-12 mb-3">
                            <label for="nextBusinessDay" class="form-label">Next Business Day <span class="text-danger">*</span></label>
                            <input type="text" class="form-control datepicker" id="nextBusinessDay" style="padding: 6px 12px !important;" required>
                        </div>
                        <div class="col-12 mb-3">
                            <label for="todayWorkResults" class="form-label">Today's Work Results <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="todayWorkResults" rows="3" required></textarea>
                        </div>
                        <div class="col-12 mb-3">
                            <label for="plannedWorkTomorrow" class="form-label">Planned Work for Tomorrow <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="plannedWorkTomorrow" rows="3" required></textarea>
                        </div>
                        <div class="col-12 mb-3">
                            <label for="suggestions" class="form-label">Suggestions</label>
                            <textarea class="form-control" id="suggestions" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-center">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="genEmail()">
                        <i class="fa-solid fa-envelope me-2"></i>
                        <span>Generate Email</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-12">
            <div class="card my-3 h-100">
                <div class="card-body">
                    <div class="card-title mb-3 pb-2 border-1 border-bottom">
                        <h4 class="text-center">Email template</h4>
                    </div>
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label for="emailTo" class="form-label d-flex justify-content-between align-items-center">
                                <span>Email To</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" title="Copy" onclick="copyField('#emailTo')">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="emailTo" readonly>
                            </div>
                        </div>
                        @if (true)
                        {
                            <div class="col-12 mb-3">
                                <label for="emailCc" class="form-label d-flex justify-content-between align-items-center">
                                    <span>Email CC</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Copy" onclick="copyField('#emailCc')">
                                        <i class="fa-regular fa-copy"></i>
                                    </button>
                                </label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="EmailCc" readonly>
                                </div>
                            </div>
                        }
                        <div class="col-12 mb-3">
                            <label for="subject" class="form-label d-flex justify-content-between align-items-center">
                                <span>Subject</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" title="Copy" onclick="copyField('#subject')">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="subject" readonly>
                            </div>
                        </div>
                        <div class="col-12 mb-3">
                            <label for="body" class="form-label d-flex justify-content-between align-items-center">
                                <span>Body</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" title="Copy" onclick="copyField('#body')">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </label>
                            <div class="input-group">
                                <textarea class="form-control" id="body" rows="9" readonly></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        var currentDate = new Date();
        var nextDate = new Date(currentDate);

        if (currentDate.getDay() === 6) {
            nextDate.setDate(currentDate.getDate() + 2);
        } else {
            nextDate.setDate(currentDate.getDate() + 1);
        }

        $('#currentBusinessDay').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            todayHighlight: true,
            clearBtn: true
        }).datepicker('setDate', currentDate);

        $('#nextBusinessDay').datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            todayHighlight: true,
            clearBtn: true,
            startDate: currentDate
        }).datepicker('setDate', nextDate);
    });

    function copyField(selector) {
        const text = $(selector).val()?.trim();

        if (!text) {
            showToast('Không có nội dung để copy!', 'Thông báo', 'warning');
            return;
        }

        navigator.clipboard.writeText(text)
            .then(() => showToast('Copy thành công!', 'Thông báo', 'success'))
            .catch(() => showToast('Copy thất bại!', 'Thông báo', 'error'));
    }

    async function genEmail() {
        const currentBusinessDay = $('#currentBusinessDay').datepicker('getUTCDate');
        const nextBusinessDay = $('#nextBusinessDay').datepicker('getUTCDate');
        const todayWorkResults = $('#todayWorkResults').val().trim();
        const plannedWorkTomorrow = $('#plannedWorkTomorrow').val().trim();
        const suggestions = $('#suggestions').val().trim();

        var request = {
            currentBusinessDay,
            nextBusinessDay,
            todayWorkResults,
            plannedWorkTomorrow,
            suggestions
        };

        await ajaxService.post('/Utility/GenerateEmailDailyReport', request, {
            showToast: true,
            onSuccess: function (res) {
                if (res.isOk()) {
                    $('#emailTo').val(res.data.emailTo);
                    $('#emailCc').val(res.data.emailCc);
                    $('#subject').val(res.data.subject);
                    $('#body').val(res.data.body);
                }
                else {
                    showToast(res.message || 'Error', 'Thông báo', 'error');
                }
            }
        });
    }
</script>