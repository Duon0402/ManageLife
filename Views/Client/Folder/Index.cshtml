@{
    ViewData["Title"] = "Photo Albums";
    this.UseCss(new ResourceLink("~/css/folder.css"));
}

<div id="folder-page">
    <div class="folder-page-header">
        <h2><i class="fa-solid fa-images"></i> Photo Albums</h2>
        <button class="btn-create-folder" id="btn-create-folder">
            <i class="fa-solid fa-plus"></i> Tạo Album
        </button>
    </div>

    <div class="folder-grid" id="folder-grid">
        <!-- Rendered by JS -->
    </div>

    <div class="folder-empty" id="folder-empty" style="display:none;">
        <i class="fa-regular fa-folder-open d-block"></i>
        <p>Chưa có album nào. Hãy tạo album đầu tiên!</p>
    </div>
</div>

<script>
    $(function () {
        new App.FolderPage("#folder-page");
    });
</script>
