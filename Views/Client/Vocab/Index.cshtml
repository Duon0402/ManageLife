@{
    ViewData["Title"] = "Học từ vựng";
}

<style>
    .vocab-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .vocab-header h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #2c2c54;
        margin: 0;
    }

    .vocab-toolbar {
        display: flex;
        gap: 10px;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
    }

    .vocab-search {
        flex: 1;
        min-width: 200px;
        border-radius: 8px;
        border: 1px solid #ddd;
        padding: 8px 14px;
        font-size: 0.9rem;
    }

    .vocab-table-wrap {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e8e8e8;
        overflow: hidden;
    }

    .vocab-table {
        width: 100%;
        border-collapse: collapse;
    }

    .vocab-table thead th {
        background: #f8f7ff;
        padding: 12px 16px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #666;
        border-bottom: 1px solid #e8e8e8;
        white-space: nowrap;
    }

    .vocab-table tbody tr {
        border-bottom: 1px solid #f2f2f2;
        transition: background 0.15s;
    }

    .vocab-table tbody tr:last-child {
        border-bottom: none;
    }

    .vocab-table tbody tr:hover {
        background: #faf9ff;
    }

    .vocab-table td {
        padding: 12px 16px;
        font-size: 0.9rem;
        vertical-align: middle;
    }

    .word-cell strong {
        color: #2c2c54;
        font-size: 1rem;
    }

    .word-phonetic {
        font-size: 0.8rem;
        color: #888;
        font-style: italic;
    }

    .word-pos {
        display: inline-block;
        background: #f0eeff;
        color: #667eea;
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .mastery-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .mastery-0 { background: #f0f0f0; color: #888; }
    .mastery-1 { background: #fff3cd; color: #856404; }
    .mastery-2 { background: #cfe2ff; color: #0a58ca; }
    .mastery-3 { background: #d1e7dd; color: #0f5132; }

    .btn-action {
        border: none;
        background: none;
        padding: 4px 8px;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s;
        font-size: 0.9rem;
    }

    .btn-action.edit { color: #667eea; }
    .btn-action.edit:hover { background: #f0eeff; }
    .btn-action.delete { color: #e74c3c; }
    .btn-action.delete:hover { background: #fde8e8; }
    .btn-action.audio { color: #27ae60; }
    .btn-action.audio:hover { background: #e8f8ef; }

    .vocab-empty {
        text-align: center;
        padding: 60px 20px;
        color: #aaa;
    }

    .vocab-empty i { font-size: 3.5rem; margin-bottom: 12px; color: #ddd; }

    /* Lookup section */
    .lookup-section {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .lookup-section .form-control {
        flex: 1;
    }

    .lookup-section .btn {
        flex-shrink: 0;
    }

    .lookup-result {
        background: #f8f7ff;
        border: 1px solid #e0dbff;
        border-radius: 8px;
        padding: 14px;
        margin-top: 12px;
    }

    .lookup-meaning-item {
        padding: 8px 10px;
        border-radius: 6px;
        border: 1px solid #e0dbff;
        cursor: pointer;
        margin-bottom: 6px;
        transition: all 0.15s;
    }

    .lookup-meaning-item:hover, .lookup-meaning-item.selected {
        background: #667eea;
        color: #fff;
        border-color: #667eea;
    }

    .lookup-meaning-item.selected .text-muted {
        color: rgba(255,255,255,0.75) !important;
    }

    /* Layout 2 cột */
    .vocab-layout {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 20px;
        align-items: start;
    }

    @@media (max-width: 768px) {
        .vocab-layout { grid-template-columns: 1fr; }
    }

    /* Sidebar */
    .vocab-sidebar {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e8e8e8;
        padding: 16px;
    }

    .sidebar-section-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #999;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sidebar-section-title button {
        background: none;
        border: none;
        color: #667eea;
        font-size: 0.85rem;
        cursor: pointer;
        padding: 0;
    }

    .sidebar-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 10px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.88rem;
        color: #444;
        transition: background 0.15s;
        text-decoration: none;
    }

    .sidebar-item:hover { background: #f0eeff; color: #667eea; }
    .sidebar-item.active { background: #f0eeff; color: #667eea; font-weight: 600; }

    .sidebar-item .badge-count {
        margin-left: auto;
        background: #f0eeff;
        color: #667eea;
        font-size: 0.72rem;
        padding: 1px 7px;
        border-radius: 20px;
        font-weight: 600;
    }

    .topic-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .sidebar-divider { border-top: 1px solid #f0f0f0; margin: 10px 0; }

    /* Custom scrollbar cho modal body */
    #modal-word .modal-body {
        scrollbar-width: thin;
        scrollbar-color: #d0d3e0 transparent;
    }

    #modal-word .modal-body::-webkit-scrollbar {
        width: 4px;
    }

    #modal-word .modal-body::-webkit-scrollbar-thumb {
        background: #d0d3e0;
        border-radius: 4px;
    }

    #modal-word .modal-body::-webkit-scrollbar-track {
        background: transparent;
    }
</style>

<div id="vocab-page">
    <div class="vocab-header">
        <h2><i class="fa-solid fa-book-open me-2"></i> Từ vựng của tôi</h2>
        <button class="btn btn-primary btn-sm" id="btn-add-word">
            <i class="fa-solid fa-plus me-1"></i> Thêm từ
        </button>
    </div>

    <div class="vocab-layout">
        <!-- Sidebar -->
        <aside class="vocab-sidebar">
            <div class="sidebar-section-title">
                Chủ đề
                <button id="btn-add-topic" title="Thêm chủ đề"><i class="fa-solid fa-plus"></i></button>
            </div>
            <div id="topic-list">
                <div class="sidebar-item active" data-topic="">
                    <i class="fa-solid fa-layer-group"></i> Tất cả
                </div>
            </div>

            <div class="sidebar-divider"></div>

            <div class="sidebar-section-title">
                Bộ thẻ (Deck)
                <button id="btn-add-deck" title="Thêm deck"><i class="fa-solid fa-plus"></i></button>
            </div>
            <div id="deck-list">
                <div class="text-muted" style="font-size:0.82rem;padding:4px 10px">Chưa có deck nào</div>
            </div>
        </aside>

        <!-- Main content -->
        <div>
            <div class="vocab-toolbar">
                <input type="text" class="vocab-search" id="vocab-search" placeholder="Tìm kiếm từ vựng...">
            </div>

    <div class="vocab-table-wrap">
        <table class="vocab-table">
            <thead>
                <tr>
                    <th>Từ / Phiên âm</th>
                    <th>Loại từ</th>
                    <th>Định nghĩa</th>
                    <th>Dịch nghĩa</th>
                    <th>Mức độ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="vocab-tbody">
                <tr>
                    <td colspan="6">
                        <div class="vocab-empty">
                            <i class="fa-solid fa-spinner fa-spin d-block"></i>
                            <p>Đang tải...</p>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        </div><!-- end vocab-table-wrap -->
        </div><!-- end main content -->
    </div><!-- end vocab-layout -->
</div><!-- end vocab-page -->

<!-- Modal: Thêm / Sửa từ -->
<div class="modal fade" id="modal-word" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-word-title">Thêm từ mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Lookup -->
                <div class="mb-3" id="lookup-section">
                    <label class="form-label fw-semibold">Tra từ điển</label>
                    <div class="lookup-section">
                        <input type="text" class="form-control" id="lookup-input" placeholder="Nhập từ cần tra...">
                        <button class="btn btn-outline-primary btn-sm" id="btn-lookup" style="white-space:nowrap">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> Tra cứu
                        </button>
                    </div>
                    <div id="lookup-result" style="display:none"></div>
                </div>

                <hr class="my-3">

                <input type="hidden" id="word-id">
                <input type="hidden" id="word-raw-json">
                <input type="hidden" id="word-dict-source" value="0">

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Từ <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="word-word">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Phiên âm</label>
                        <input type="text" class="form-control" id="word-phonetic">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Loại từ</label>
                        <input type="text" class="form-control" id="word-pos" placeholder="noun, verb...">
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Định nghĩa <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="word-definition" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Câu ví dụ</label>
                        <textarea class="form-control" id="word-example" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Dịch nghĩa (tiếng Việt)</label>
                        <input type="text" class="form-control" id="word-translation">
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Link audio</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="word-audio">
                            <button class="btn btn-outline-success" type="button" id="btn-play-audio" title="Nghe thử">
                                <i class="fa-solid fa-volume-high"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary btn-sm" id="btn-save-word">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
        new App.VocabPage('#vocab-page');
    });
</script>

<!-- Modal: Topic -->
<div class="modal fade" id="modal-topic" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-topic-title">Thêm chủ đề</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="topic-id">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên chủ đề <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="topic-name">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mô tả</label>
                    <input type="text" class="form-control" id="topic-desc">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Màu sắc</label>
                    <input type="color" class="form-control form-control-color" id="topic-color" value="#667eea">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary btn-sm" id="btn-save-topic">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Deck -->
<div class="modal fade" id="modal-deck" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-deck-title">Thêm bộ thẻ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deck-id">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên bộ thẻ <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="deck-name">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mô tả</label>
                    <input type="text" class="form-control" id="deck-desc">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Chủ đề</label>
                    <select class="form-select" id="deck-topic">
                        <option value="">-- Không có chủ đề --</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary btn-sm" id="btn-save-deck">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>
