@model ManageLife.ViewModels.ChatViewModel
@{
    ViewData["Title"] = "Chat Test";
}

<div class="container mt-4" id="chat-page">
    <h2><i class="fa-regular fa-comments me-2"></i> Chat Test</h2>

    <div class="row mt-4">
        <!-- Sidebar for User Selection -->
        <div class="col-md-4 border-end">
            <h4>Chọn người dùng</h4>
            <div class="mb-3">
                <select id="targetUserId" class="form-select">
                    <option value="">-- Chọn người dùng --</option>
                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Id">@user.DisplayName</option>
                    }
                </select>
                <button id="startChatBtn" class="btn btn-primary mt-2 w-100">
                    <i class="fa-regular fa-paper-plane me-2"></i> Bắt đầu chat
                </button>
            </div>

            <hr />
            <h5>Current Room</h5>
            <div id="currentRoomInfo" class="text-muted">No room selected</div>
        </div>

        <!-- Chat Area -->
        <div class="col-md-8">
            <div id="chatBox" class="border rounded p-3 mb-3 d-flex flex-column" style="height: 400px; overflow-y: scroll; background-color: #f8f9fa;">
                <div id="messagesList" class="d-flex flex-column w-100 mt-auto"></div>
            </div>

            <div id="typingIndicator" class="text-muted mb-2" style="display: none; font-size: 0.9em;">
                <em>Đang nhập...</em>
            </div>

            <div class="input-group">
                <input type="text" id="messageInput" class="form-control" placeholder="Nhập tin nhắn..." disabled>
                <button id="sendBtn" class="btn btn-success" disabled>Gửi</button>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/microsoft-signalr/signalr.min.js"></script>
<script>
    $(function () {
        new App.ChatPage("#chat-page", {
            currentUserId: '@Model.CurrentUserId',
            users: @Html.Raw(Json.Serialize(Model.Users.Select(u => new { id = u.Id, displayName = u.DisplayName })))
        });
    });
</script>
