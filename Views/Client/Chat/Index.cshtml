@{
    ViewData["Title"] = "Chat";
    this.UseCss(new ResourceLink("~/css/chat.css"));
}

<div class="container mt-4" id="chat-page" data-user-id="@User.Claims.FirstOrDefault(c => c.Type == "Id")?.Value">
    <h2><i class="fa-regular fa-comments"></i> Chat</h2>

    <div class="row mt-3">
        <!-- Sidebar for User Selection -->
        <div class="col-md-4 chat-users-panel">
            <h4>Select User</h4>
            <div class="mb-3">
                <input type="text" id="targetUserId" class="form-control" placeholder="Enter User ID">
                <button id="startChatBtn" class="btn btn-primary mt-2 w-100">
                    <i class="fa-regular fa-paper-plane me-2"></i> Bắt đầu chat
                </button>
            </div>

            <hr />
            <h5>Current Room</h5>
            <div id="currentRoomInfo">No room selected</div>
        </div>

        <!-- Chat Area -->
        <div class="col-md-8">
            <div id="chatBox" class="border rounded p-3 mb-3 d-flex flex-column">
                <div id="messagesList" class="d-flex flex-column w-100 mt-auto"></div>
            </div>

            <div id="typingIndicator" class="text-muted mb-2" style="display: none;">
                <em>User is typing...</em>
            </div>

            <div class="input-group chat-input-row">
                <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." disabled>
                <button id="sendBtn" class="btn btn-success" disabled>
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    $(function () {
        new App.ChatPage("#chat-page");
    });
</script>
