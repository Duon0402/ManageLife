@{
    Layout = RazorPageConst.Layout.AuthLayout;
    Options.Title = "Đổi mật khẩu";
}

<div class="auth-wrapper" id="auth-change-password-page">
    <div class="auth-card">

        <div class="auth-brand">
            <div class="auth-brand-inner">
                <div class="auth-brand-icon">
                    <i class="fa-solid fa-key"></i>
                </div>
                <div class="auth-brand-title">Bảo mật</div>
                <div class="auth-brand-subtitle">
                    Đổi mật khẩu định kỳ giúp bảo vệ tài khoản của bạn tốt hơn.
                </div>
                <div class="auth-brand-dots">
                    <span></span>
                    <span></span>
                    <span class="active"></span>
                </div>
            </div>
        </div>

        <div class="auth-form-panel">
            <div class="auth-form-logo">
                <i class="fa-solid fa-infinity"></i>
                <span>ManageLife</span>
            </div>

            <div class="auth-form-title">Đổi mật khẩu</div>
            <div class="auth-form-subtitle">Nhập mật khẩu cũ và mật khẩu mới của bạn</div>

            <form id="changePasswordForm" novalidate>
                <div class="mb-3">
                    <label for="oldPassword" class="form-label">Mật khẩu hiện tại</label>
                    <div class="input-group has-toggle">
                        <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                        <input type="password" class="form-control" id="oldPassword" name="OldPassword"
                               placeholder="Nhập mật khẩu hiện tại" autocomplete="current-password" required />
                        <button class="auth-input-toggle btn" type="button" id="toggleOld" tabindex="-1">
                            <i class="fa-regular fa-eye" id="toggleOldIcon"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="newPassword" class="form-label">Mật khẩu mới</label>
                    <div class="input-group has-toggle">
                        <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
                        <input type="password" class="form-control" id="newPassword" name="NewPassword"
                               placeholder="Nhập mật khẩu mới" autocomplete="new-password" required />
                        <button class="auth-input-toggle btn" type="button" id="toggleNew" tabindex="-1">
                            <i class="fa-regular fa-eye" id="toggleNewIcon"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="confirmNewPassword" class="form-label">Xác nhận mật khẩu mới</label>
                    <div class="input-group has-toggle">
                        <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
                        <input type="password" class="form-control" id="confirmNewPassword" name="ConfirmNewPassword"
                               placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" required />
                        <button class="auth-input-toggle btn" type="button" id="toggleConfirm" tabindex="-1">
                            <i class="fa-regular fa-eye" id="toggleConfirmIcon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="auth-btn" id="btnChangePassword">
                    <i class="fa-solid fa-floppy-disk me-2"></i>
                    Lưu mật khẩu mới
                </button>
            </form>

            <div class="auth-footer">
                <a href="javascript:history.back()">
                    <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                </a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    $(function () {
        new App.AuthChangePasswordPage("#auth-change-password-page");

        function bindToggle(btnId, inputId, iconId) {
            $('#' + btnId).on('click', function () {
                var input = $('#' + inputId);
                var icon = $('#' + iconId);
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });
        }

        bindToggle('toggleOld', 'oldPassword', 'toggleOldIcon');
        bindToggle('toggleNew', 'newPassword', 'toggleNewIcon');
        bindToggle('toggleConfirm', 'confirmNewPassword', 'toggleConfirmIcon');
    });
</script>
}
