@{
    var title = T(TranslationKey.Client.Login.Title);
    Options.Title = title;
    this.UseCss(new ResourceLink("~/css/auth.css"));
}

<div class="container d-flex justify-content-center align-items-center py-5" id="auth-login-page">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@title</h5>
            <p class="card-subtitle">Sign in to continue.</p>
            <form id="loginForm">
                <div class="mb-3">
                    <label for="username" class="form-label">@T(TranslationKey.Client.Login.Field.UserName)</label>
                    <input type="text" class="form-control" id="username" name="Username" placeholder="Enter username" required />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">@T(TranslationKey.Client.Login.Field.Password)</label>
                    <input type="password" class="form-control" id="password" name="Password" placeholder="Enter password" required />
                </div>
                <button type="submit" class="btn btn-primary w-100 mt-2" id="btnLogin">
                    @T(TranslationKey.Client.Login.Button.Login)
                </button>
            </form>
            <div class="auth-footer-link">
                Don't have an account? <a href="/Auth/Register">Register</a>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
        new App.AuthLoginPage("#auth-login-page");
    });
</script>
