@model AdminPermissionViewModel
@{
    Options.Title = "Permission";
    Options.UseFormData = true;
    if (Model.TargetType == PermissionTargetType.User)
    {
        Options.Breadcrumb.AddRange(
            new List<BreadcrumbItem>
            {
                new BreadcrumbItem("/admin/user/", "User"),
                new BreadcrumbItem("/admin/permission/", "Permission", true),
            }
        );
        Options.EnableBackButton("/admin/user");
    }
    else
    {
        Options.Breadcrumb.AddRange(
            new List<BreadcrumbItem>
            {
                new BreadcrumbItem("/admin/role/", "Role"),
                new BreadcrumbItem("/admin/permission/", "Permission", true),
            }
        );
        Options.EnableBackButton("/admin/role");
    }
}

@section FormData {
    <div class="col-4">
        <div class="row gx-2 align-items-center">
            @if (Model.TargetType == PermissionTargetType.User)
            {
                <div class="col-auto">
                    <label class="col-form-label">Username</label>
                </div>
                <div class="col">
                    <input type="text" class="form-control" value="@Model.UserName" readonly>
                </div>
            }
            else
            {
                <div class="col-auto">
                    <label class="col-form-label">Role</label>
                </div>
                <div class="col">
                    <input type="text" class="form-control" value="@Model.RoleName" readonly>
                </div>
            }
        </div>

        <input type="hidden" id="targetType" value="@((int)Model.TargetType)" />
        <input type="hidden" id="userId" value="@Model.UserId" />
        <input type="hidden" id="roleId" value="@Model.RoleId" />
    </div>
}

<div class="permission-wrap" id="admin-permission-page">
    <div class="d-flex w-100 h-100 justify-content-between">
        <div class="permission-panel border rounded p-2" style="width: calc(50% - 40px);">
            <div class="fw-bold mb-2 text-center border-1 border-bottom">
                Unassigned Permissions
            </div>
            <table id="tblUnassigned" class="table w-100"></table>
        </div>
        <div class="d-flex flex-column justify-content-center align-items-center gap-3" style="width: 80px;">
            <button id="btnAssign" class="btn btn-outline-primary">
                <i class="fa-solid fa-angles-right"></i>
            </button>
            <button id="btnUnassign" class="btn btn-outline-danger">
                <i class="fa-solid fa-angles-left"></i>
            </button>
        </div>
        <div class="permission-panel border rounded p-2" style="width: calc(50% - 40px);">
            <div class="fw-bold mb-2 text-center border-1 border-bottom">
                Assigned Permissions
            </div>
            <table id="tblAssigned" class="table w-100"></table>
        </div>
    </div>
</div>

<script>
    $(function () {
        new App.AdminPermissionPage("#admin-permission-page", @Json.Serialize(Model));
    });
</script>