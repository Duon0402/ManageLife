@{
    Layout = "~/Views/Shared/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Cron Job";
}

<table id="cronJobsTable" class="table table-striped">
    <thead>
        <tr>
            <th>Job ID</th>
            <th>Tiêu đề</th>
            <th>Trạng thái</th>
            <th>URL</th>
        </tr>
    </thead>
    <tbody>
        
    </tbody>
</table>


<script>
    $(document).ready(function () {
        loadCronJobs();
    });

    function loadCronJobs() {
        ajaxService.get('/Admin/CronJob/GetListCronJobs', null, {
            onSuccess: function (response) {
                if (response.isOk()) {
                    const tbody = $('#cronJobsTable tbody');
                    tbody.empty();

                    response.data.forEach(job => {
                        const statusText = job.enabled ? 'Hoạt động' : 'Tạm dừng';
                        const row = `
                            <tr>
                                <td>${job.jobId}</td>
                                <td>${job.title}</td>
                                <td>${statusText}</td>
                                <td>${job.url}</td>
                            </tr>
                        `;
                        tbody.append(row);
                    });
                } else {
                    showToast(response.message || 'Lấy danh sách thất bại', 'Thông báo', 'error');
                }
            },
            onError: function (jqXHR) {
                showToast('Lỗi server khi lấy danh sách cron jobs', 'Thông báo', 'error');
            }
        });
    }

</script>
