@{
    Options.Title = "Language";
    Options.Breadcrumb.Add("/language", "Language");
}

<style>
    #tblLanguage_wrapper .dt-search label {
        display: none;
    }
</style>

<div class="user-wrap">
    <table id="tblLanguage" class="display w-100 table-bordered"></table>
</div>
@await Html.PartialAsync("~/Views/Admin/Language/_LanguageModal.cshtml")

<script>
    let table = null;
    let languageModalMode = 'create';
    let editingLanguageId = null;

    $(function () {
        table = initTable("#tblLanguage");
        loadData();
    });

    function loadData() {
        GetListLanguagesAsync();
    }

    async function GetListLanguagesAsync() {
        ajaxService.get('/Admin/Language/GetListLanguages', null, {
            onSuccess: function (response) {
                if (response.isOk()) {
                    const data = response.data || [];
                    table.clear();
                    table.rows.add(data);
                    table.draw();

                } else {
                    showToast(response.message || 'Error', 'Thông báo', 'error');
                }
            },
            onError: function () {
                showToast('Không thể tải danh sách user', 'Thông báo', 'error');
            }
        });
    }

    function initTable(selector) {
        return $(selector).DataTable({
            buttons: [
                {
                    text: '<i class="fa-solid fa-plus"></i>',
                    className: 'btn btn-sm btn-outline-secondary',
                    titleAttr: 'Thêm mới',
                    action: function () {
                        createLanguage();
                    }
                }
            ],
            layout: {
                topEnd: [
                    'buttons',
                    'search'
                ],
            },
            scrollY: 'calc(100vh - 395px)',
            scrollCollapse: true,
            destroy: true,
            data: [],
            paging: false,
            info: false,
            ordering: false,
            searching: true,
            autoWidth: true,
            columns: [
                { title: "ID", data: "id", visible: false },
                { title: "Code", data: "code" },
                { title: "Name", data: "name"},
                {
                    title: "",
                    data: null,
                    orderable: false,
                    searchable: false,
                    className: "text-center",
                    width: "120px",
                    render: function (row) {
                        return `
                            <button class="btn btn-sm btn-outline-primary btn-edit"
                                    data-id="${row.id}"
                                    title="Sửa">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger btn-delete"
                                    data-id="${row.id}"
                                    title="Xóa">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        `;
                    }
                }
            ]
        });
    }

    function createLanguage() {
        openLanguageModal(null);
    }

    function editLanguage(language) {
        openLanguageModal(language);
    }


    function openLanguageModal(data = null) {
        resetLanguageForm();
        if (data) {
            languageModalMode = 'edit';
            editingLanguageId = data.id;

            $('#languageModalLabel').text('Cập nhật ngôn ngữ');
            $('#txtCode').val(data.code);
            $('#txtName').val(data.name);

            console.log('OPEN MODAL - EDIT', data);
        } else {
            languageModalMode = 'create';
            editingLanguageId = null;

            $('#languageModalLabel').text('Thêm ngôn ngữ');

            console.log('OPEN MODAL - CREATE');
        }

        $('#languageModal').modal('show');
    }

    function resetLanguageForm() {
        $('#txtCode').val('');
        $('#txtName').val('');
    }

    // Edit
    $('#tblLanguage').on('click', '.btn-edit', function () {
        const rowData = table.row($(this).closest('tr')).data();
        editLanguage(rowData);
    });

    // Delete
    $('#tblLanguage').on('click', '.btn-delete', function () {
        const rowData = table.row($(this).closest('tr')).data();
        console.log("DELETE language:", rowData);
    });
</script>
