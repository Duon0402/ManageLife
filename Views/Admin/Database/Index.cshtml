@model ManageLife.ViewModels.DatabaseViewModel
@{
    Options.Title = "Database";
    Options.Breadcrumb.Add("/Admin/Database", "Database");
    this.UseCss(new ResourceLink("~/css/admin-database.css"));
}

<div id="admin-database-page"
     data-pending-count="@Model.PendingCount"
     data-pending="@System.Text.Json.JsonSerializer.Serialize(Model.Pending)"
     data-applied="@System.Text.Json.JsonSerializer.Serialize(Model.Applied)"
     data-has-migration-key="@Model.HasMigrationKey">
</div>

<script>
    $(function () {
        new App.AdminDatabasePage('#admin-database-page');
    });
</script>
