@model TranslationViewModel
@{
    Options.Title = "Translation";
    Options.Breadcrumb.Add("/translation", "Translation");
}

<div id="admin-translation-page">
    <h2>Quản lý Translation</h2>

    <div class="mb-3">
        <button class="btn btn-primary" id="btnLoad">Load danh sách</button>
    </div>

    <div class="card mb-3 p-3">
        <h5>Thêm Translation</h5>
        <div class="row g-2">
            <div class="col-md-3">
                <input type="text" class="form-control" id="txtKey" placeholder="Key" />
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control" id="txtValue" placeholder="Value" />
            </div>
            <div class="col-md-3">
                <select id="ddlLanguageId" class="form-control">
                    <option value="">-- Chọn ngôn ngữ --</option>
                    @foreach (var lang in Model.Languages)
                    {
                        <option value="@lang.Key">@lang.Value</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-success w-100" id="btnCreate">Thêm mới</button>
            </div>
        </div>
    </div>

    <table class="table table-bordered" id="tblTranslations">
        <thead>
            <tr>
                <th>Key</th>
                <th>Value</th>
                <th>Language</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<script>
    $(function () {
        new App.AdminTranslationPage("#admin-translation-page", @Json.Serialize(Model));
    });
</script>
