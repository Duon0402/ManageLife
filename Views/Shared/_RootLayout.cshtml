@{
    var title = this.GetTitle();

    if (title.IsEmpty())
    {
        title = "Manage Life";
    }

    this.UseCss(
        new ResourceLink("~/lib/bootstrap/dist/css/bootstrap.min.css"),
        new ResourceLink("https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css", isCdn: true),
        new ResourceLink("~/lib/photoswipe/photoswipe.css"),
        new ResourceLink("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css", isCdn: true),
        new ResourceLink("https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css", isCdn: true),
        new ResourceLink("~/css/site.css"),
        new ResourceLink("~/css/loading.css"),
        new ResourceLink("~/css/toast.css"),
        new ResourceLink("~/css/message.css"),
        new ResourceLink("~/css/file-uploader.css")
    );

    this.UseScriptAtHead(
        new ResourceLink("~/lib/jquery/dist/jquery.min.js")
    );

    this.UseScriptAtBottom(
        new ResourceLink("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"),
        new ResourceLink("https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js", isCdn: true),
        new ResourceLink("~/lib/photoswipe/photoswipe.umd.min.js"),
        new ResourceLink("~/lib/photoswipe/photoswipe-lightbox.umd.min.js"),
        new ResourceLink("~/js/app.js", false, true)
    );
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" />

    @if (Options.HasCss)
    {
        foreach (var item in Options.CssLinks)
        {
            <link rel="stylesheet" href="@item.Url" asp-append-version="@item.AppendVersion" />
        }
    }

    @if (Options.HasHeadScripts)
    {
        foreach (var item in Options.ScriptHeadLinks)
        {
            <script src="@item.Url" asp-append-version="@item.AppendVersion"></script>
        }
    }
</head>
<body>
    @RenderBody()
    @await Html.PartialAsync("_MessageModal")
    @if (Options.HasBottomScripts)
    {
        foreach (var item in Options.ScriptBottomLinks)
        {
            <script src="@item.Url" asp-append-version="@item.AppendVersion"></script>
        }
    }

    @RenderSection("Scripts", required: false)
</body>
</html>
