@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Admin</title>

	<!-- Bootstrap loca -->
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

	<!-- CSS admin riêng -->
	<link rel="stylesheet" href="~/css/admin-layout.css" asp-append-version="true" />

	<!-- Icon -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>

	<div class="admin-layout">
		<partial name="Admin/_AdminHeader" />

		<div class="d-flex flex-grow-1">
			<partial name="Admin/_AdminSidebar" />

			<main class="content-container flex-grow-1 px-5 py-4">
				@RenderBody()
			</main>
		</div>
	</div>

	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/ajaxService.js"></script>
	<script src="~/js/toast.js"></script>
	<script src="~/js/loading.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@RenderSection("Scripts", required: false)
</body>
</html>
