@{
    Layout = RazorPageConst.Layout.RootLayout;
    this.UseCss(new ResourceLink("~/css/admin-layout.css"));
}
<div class="admin-layout">
    <partial name="Admin/_AdminHeader" />

    <div class="d-flex flex-grow-1">
        <partial name="Admin/_AdminSidebar" />

        <main class="content-container flex-grow-1 px-5 py-4">
            @if (Options.ShowBreadcrumb)
            {
                <partial name="Admin/_AdminBreadcrumb" model="Options.Breadcrumb" />
            }

            @RenderBody()
        </main>
    </div>
</div>