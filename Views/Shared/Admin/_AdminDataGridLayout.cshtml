@{
    Layout = RazorPageConst.Layout.AdminLayout;
    var title = this.GetTitle();

    this.UseCss(
        new ResourceLink("https://cdn.datatables.net/2.3.4/css/dataTables.dataTables.min.css", isCdn: true),
        new ResourceLink("https://cdn.datatables.net/select/3.1.3/css/select.dataTables.min.css", isCdn: true),
        new ResourceLink("~/css/grid-table.css")
    );

    this.UseScriptAtBottom(
        new ResourceLink("https://cdn.datatables.net/2.3.4/js/dataTables.min.js", isCdn: true),
        new ResourceLink("https://cdn.datatables.net/select/3.1.3/js/dataTables.select.min.js", isCdn: true),
        new ResourceLink("https://cdn.datatables.net/buttons/3.0.0/js/dataTables.buttons.min.js", isCdn: true)
    );
}

<div class="tooltip-container card d-flex flex-row justify-content-between align-items-center mb-3 py-2 px-3" style="min-height: 56px;">
    <div class="tooltip-item-start d-flex flex-row align-items-center gap-3">
        @if (Options.ShowBackButton)
        {
            <button class="btn btn-outline-secondary" id="back_btn" onclick="onBackClick()">Back</button>
        }
        <div class="text-uppercase fw-bold">@title</div>
    </div>
    <div class="tooltip-item-center d-flex flex-row align-items-center gap-3">
    </div>
    @* <div class="tooltip-item-end d-flex flex-row align-items-center gap-3">
        <button class="btn btn-outline-secondary" id="export_btn">
            Export
        </button>
    </div> *@
</div>

@if (Options.UseFormData)
{
    <div class="card my-2 form-container overflow-auto" style="max-height: 120px;">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                @RenderSection("FormData", required: false)
            </div>
        </div>
    </div>
}

<div class="grid-container card flex-grow-1" style="max-height: calc(100vh - 220px);">
    <div class="card-body overflow-auto h-100">
        @RenderBody()
    </div>
</div>

<script>
    window.options = {
        backUrl: '@(Options.BackUrl ?? string.Empty)'
    };

    function onBackClick() {
        if (window.options.backUrl) {
            window.location.href = window.options.backUrl;
        }
    }
</script>