@{
    Layout = RazorPageConst.Layout.AdminLayout;
    var title = this.GetTitle();

    this.UseCss(
        new ResourceLink("https://cdn.datatables.net/2.3.4/css/dataTables.min.css", isCdn: true),
        new ResourceLink("https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap5.min.css", isCdn: true),
        new ResourceLink("https://cdn.datatables.net/select/3.1.3/css/select.bootstrap5.min.css", isCdn: true),
        new ResourceLink("https://cdn.datatables.net/buttons/3.0.0/css/buttons.bootstrap5.min.css", isCdn: true),
        new ResourceLink("~/css/grid-table.css")
    );

    this.UseScriptAtBottom(
        new ResourceLink("https://cdn.datatables.net/2.3.4/js/dataTables.min.js", isCdn: true),
        new ResourceLink("https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.min.js", isCdn: true),
        new ResourceLink("https://cdn.datatables.net/select/3.1.3/js/dataTables.select.min.js", isCdn: true),
        new ResourceLink("https://cdn.datatables.net/buttons/3.0.0/js/dataTables.buttons.min.js", isCdn: true),
        new ResourceLink("https://cdn.datatables.net/buttons/3.0.0/js/buttons.bootstrap5.min.js", isCdn: true)
    );
}

<div id="admin-layout-container" class="d-flex flex-column" style="min-height: calc(100% - 40px);">
    <div class="tooltip-container card d-flex flex-row justify-content-between align-items-center mb-3 py-2 px-3" style="min-height: 56px;">
        <div class="tooltip-item-start d-flex flex-row align-items-center gap-3">
            @if (Options.ShowBackButton)
            {
                <button class="btn btn-sm btn-outline-secondary" id="back_btn">
                    <i class="fa-solid fa-angle-left me-1"></i>
                    <span>Back</span>
                </button>
            }
            <div class="text-uppercase fw-bold">@title</div>
        </div>
        <div class="tooltip-item-center d-flex flex-row align-items-center gap-3">
        </div>
    </div>

    @* Filter (optional) *@
    @if (Options.UseFormData)
    {
        <div class="card my-2 form-container overflow-auto" style="max-height: 120px;">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    @RenderSection("FormData", required: false)
                </div>
            </div>
        </div>
    }

    @* Grid *@
    <div class="grid-container card flex-grow-1 overflow-hidden">
        <div class="card-body p-0 h-100 d-flex flex-column">
            @RenderBody()
        </div>
    </div>

</div>

<script>
    window.options = {
        backUrl: '@(Options.BackUrl ?? string.Empty)'
    };

    $(function () {
        new App.AdminLayout("#admin-layout-container");
    });
</script>
