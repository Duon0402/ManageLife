@{
	var menus = await MenuRegister.GetListMenuItemsAsync();
	var currentPath = Context.Request.Path.ToString().ToLower();
}

<aside class="sidebar-container collapse collapse-horizontal show" id="sidebar">
	<nav class="sidebar">
		<ul class="menu">
			@foreach (var item in menus)
			{
				if (item.MenuItemType == MenuItemType.Group && item.HasSubItems)
				{
					<li class="menu-item">
						<a href="javascript:void(0)"
						   class="menu-link collapsed"
						   data-bs-toggle="collapse"
						   data-bs-target="#submenu-@item.Title.Replace(" ", "")">
							<i class="@item.Icon"></i>
							<span class="ms-2">@item.Title</span>
							<i class="fa-solid fa-chevron-down ms-auto menu-arrow"></i>
						</a>
						<ul class="sub-menu collapse" id="submenu-@item.Title.Replace(" ", "")">
							@foreach (var sub in item.SubItems)
							{
								<li class="sub-item">
									<a href="@sub.Url" class="sub-link">
										<i class="@sub.Icon"></i>
										<span class="ms-2">@sub.Title</span>
									</a>
								</li>
							}
						</ul>
					</li>
				}
				else if (item.MenuItemType == MenuItemType.Link)
				{
					<li class="menu-item">
						<a href="@item.Url" class="menu-link">
							<i class="@item.Icon"></i>
							<span class="ms-2">@item.Title</span>
						</a>
					</li>
				}
			}
		</ul>
	</nav>
</aside>