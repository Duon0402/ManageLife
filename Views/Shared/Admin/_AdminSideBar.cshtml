@{
    var menus = await MenuRegister.GetListMenuItemsAsync();
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
}

<aside class="sidebar-wrapper" id="adminSidebar">
    <div class="sidebar-brand">
        <div class="sidebar-brand-icon">
            <i class="fa-solid fa-infinity"></i>
        </div>
        <span class="sidebar-brand-name">ManageLife</span>
    </div>

    <nav class="sidebar-nav">
        <ul class="menu">
            @foreach (var item in menus)
            {
                if (item.MenuItemType == MenuItemType.Group && item.HasSubItems)
                {
                    var groupId = "submenu-" + item.Title.Replace(" ", "");
                    var isExpanded = item.SubItems.Any(s => currentPath.StartsWith(s.Url?.ToLower() ?? "__"));
                    <li class="menu-item @(isExpanded ? "active" : "")">
                        <a href="javascript:void(0)"
                           class="menu-link @(isExpanded ? "" : "collapsed")"
                           data-bs-toggle="collapse"
                           data-bs-target="#@groupId"
                           aria-expanded="@(isExpanded ? "true" : "false")">
                            <i class="menu-icon @item.Icon"></i>
                            <span class="menu-text">@item.Title</span>
                            <i class="fa-solid fa-chevron-down menu-arrow"></i>
                        </a>
                        <ul class="sub-menu collapse @(isExpanded ? "show" : "")" id="@groupId">
                            @foreach (var sub in item.SubItems)
                            {
                                var isSubActive = currentPath.StartsWith(sub.Url?.ToLower() ?? "__");
                                <li class="sub-item @(isSubActive ? "active" : "")">
                                    <a href="@sub.Url" class="sub-link">
                                        <i class="@sub.Icon" style="margin-right:.5rem;font-size:.75rem;"></i>
                                        @sub.Title
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
                else if (item.MenuItemType == MenuItemType.Link)
                {
                    var isActive = currentPath.StartsWith(item.Url?.ToLower() ?? "__");
                    <li class="menu-item @(isActive ? "active" : "")">
                        <a href="@item.Url" class="menu-link">
                            <i class="menu-icon @item.Icon"></i>
                            <span class="menu-text">@item.Title</span>
                        </a>
                    </li>
                }
            }
        </ul>
    </nav>
</aside>
