@{
	var menus = await MenuRegister.GetListMenuItemsAsync();
}

<aside class="sidebar-container collapse collapse-horizontal show" id="sidebar">
	<nav class="sidebar">
		<ul class="menu">
			@foreach (var item in menus)
			{
				if (item.SubItems != null && item.SubItems.Any())
				{
					<li class="menu-item">
						<a href="javascript:void(0)"
						   class="menu-link collapsed"
						   data-bs-toggle="collapse"
						   data-bs-target="#submenu-@item.Title.Replace(" ", "")">
							<i class="@item.Icon"></i>
							<span class="ms-2">@item.Title</span>
							<i class="fa-solid fa-chevron-down ms-auto menu-arrow"></i>
						</a>
						<ul class="sub-menu collapse" id="submenu-@item.Title.Replace(" ", "")">
							@foreach (var sub in item.SubItems)
							{
								<li class="sub-item">
									<a href="@sub.Url" class="sub-link">
										<i class="@sub.Icon"></i>
										<span class="ms-2">@sub.Title</span>
									</a>
								</li>
							}
						</ul>
					</li>
				}
				else
				{
					<li class="menu-item">
						<a href="@item.Url" class="menu-link">
							<i class="@item.Icon"></i>
							<span class="ms-2">@item.Title</span>
						</a>
					</li>
				}
			}
		</ul>
	</nav>
</aside>
<script>
	var currentUrl = window.location.pathname.toLowerCase();

	var defaultMap = {
		"/admin": "/admin/dashboard",
		"/admin/": "/admin/dashboard"
	};

	if (defaultMap[currentUrl]) {
		currentUrl = defaultMap[currentUrl];
	}

	$(".sub-menu").each(function () {
		var $submenu = $(this);
		$submenu.find(".sub-link").each(function () {
			var $link = $(this);
			if ($link.attr("href").toLowerCase() === currentUrl) {
				$link.addClass("active");
				$link.closest(".sub-item").addClass("active");
				$submenu.addClass("show");
				$submenu.prev(".menu-link").removeClass("collapsed").addClass("active");
				$submenu.closest(".menu-item").addClass("active");
			}
		});
	});

	$(".menu-item > .menu-link").each(function () {
		var $link = $(this);
		if ($link.attr("href") && $link.attr("href").toLowerCase() === currentUrl) {
			$link.addClass("active");
			$link.closest(".menu-item").addClass("active");
		}
	});
</script>