@{
    var displayName = UserContext.GetUserName() ?? "";
    var initials = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "A";
}

<header class="admin-header" id="adminHeader">
    <div class="header-left">
        <button type="button" class="btn-toggle-sidebar" id="btnToggleSidebar" title="Toggle sidebar">
            <i class="fa-solid fa-bars"></i>
        </button>
        <a href="/admin" class="header-brand">
            <i class="fa-solid fa-infinity"></i>
            <span>ManageLife</span>
        </a>
    </div>

    <div class="header-right">
        <a href="/admin" class="header-icon-btn" title="Home">
            <i class="fa-solid fa-house"></i>
        </a>
        <button type="button" class="header-icon-btn" title="Notifications">
            <i class="fa-regular fa-bell"></i>
        </button>
        <div class="dropdown user-dropdown">
            <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="user-avatar">@initials</div>
                <span class="user-name">@displayName</span>
                <i class="fa-solid fa-chevron-down dropdown-caret"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" href="/Auth/ChangePassword">
                        <i class="fa-solid fa-key"></i> Đổi mật khẩu
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <a class="dropdown-item text-danger" href="#" id="admin-logout-btn">
                        <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                    </a>
                </li>
            </ul>
        </div>
    </div>
</header>

<script>
    document.getElementById('btnToggleSidebar')?.addEventListener('click', function () {
        const sidebar = document.getElementById('adminSidebar');
        if (sidebar) sidebar.classList.toggle('collapsed');
    });

    document.getElementById('admin-logout-btn')?.addEventListener('click', function (e) {
        e.preventDefault();
        ApiService.post('/Auth/Logout', {}, { showLoading: true }).then(function (res) {
            if (res.isOk()) {
                window.location.href = '/Auth/Login';
            } else {
                ToastService.error(res.message || 'Đăng xuất thất bại');
            }
        }).catch(function () {
            ToastService.error('Lỗi hệ thống');
        });
    });
</script>
