@{
    var userName = User.Identity?.Name ?? "User";
    var userInitial = userName.Length > 0 ? userName[0].ToString().ToUpper() : "U";
}
<header class="admin-header">
    <div class="header-left">
        <button type="button" class="btn-toggle-sidebar" id="btnToggleSidebar" title="Toggle menu">
            <i class="fa-solid fa-bars"></i>
        </button>
        <a href="/Admin" class="header-brand d-none d-md-flex">
            <i class="fa-solid fa-infinity"></i>
            <span>ManageLife</span>
        </a>
    </div>

    <div class="header-right">
        <div class="dropdown user-dropdown">
            <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="user-avatar">@userInitial</div>
                <span class="user-name d-none d-md-block">@userName</span>
                <i class="fa-solid fa-chevron-down dropdown-caret ms-1"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <span class="dropdown-item pe-none" style="opacity:.6;font-size:.75rem;">
                        <i class="fa-regular fa-user me-1"></i> @userName
                    </span>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" href="/Auth/ChangePassword">
                        <i class="fa-solid fa-key"></i> Đổi mật khẩu
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <button class="dropdown-item text-danger" id="btnHeaderLogout" type="button">
                        <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                    </button>
                </li>
            </ul>
        </div>
    </div>
</header>

<script>
    (function () {
        // Toggle sidebar
        document.getElementById('btnToggleSidebar').addEventListener('click', function () {
            var sidebar = document.getElementById('adminSidebar');
            if (sidebar) sidebar.classList.toggle('collapsed');
        });

        // Logout
        document.getElementById('btnHeaderLogout').addEventListener('click', function () {
            fetch('/Auth/Logout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
            }).finally(function () {
                window.location.href = '/Auth/Login';
            });
        });
    })();
</script>
