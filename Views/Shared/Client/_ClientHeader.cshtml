@{
    var currentLanguageCode = LanguageContext.GetCurrentLanguage();
    var currentLanguageName = await LanguageContext.GetCurrentLanguageNameAsync(currentLanguageCode);
}

<header class="header d-flex justify-content-between align-items-center px-5">
    <div class="logo d-flex align-items-center">
        <a href="/">
            <h3 class="brand">Manage Life</h3>
        </a>
    </div>

    <nav class="nav-menu d-flex align-items-center">
        <ul class="nav">
            <li class="nav-item">
                <a class="nav-link px-3" href="/">@T(TranslationKey.Client.Header.Menu.Home)</a>
            </li>

            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle px-3" href="#" data-bs-toggle="dropdown">
                    @T(TranslationKey.Client.Header.Menu.Utility.Title)
                </a>
                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" href="/Utility/EmailDailyReport">
                            @T(TranslationKey.Client.Header.Menu.Utility.EmailDailyReport)
                        </a>
                    </li>
                </ul>
            </li>
        </ul>
    </nav>

    <div class="language">
        <div class="dropdown">
            <button id="currentLangBtn" class="dropdown-toggle btn btn-light" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                @currentLanguageName
            </button>
            <ul class="dropdown-menu" id="languageMenu"></ul>
        </div>
    </div>
</header>

<input type="hidden" id="currentLangCode" value="@currentLanguageCode" />

<script>
    $(function () {
        const currentLangCode = $('#currentLangCode').val();
        loadLanguages();
        function loadLanguages() {
            ajaxService.get('/Language/GetListLanguages', {}, {
                showLoading: false,
                onSuccess: function (res) {
                    if (res.isOk() && res.data) {
                        const $menu = $('#languageMenu');
                        $menu.empty();

                        res.data.forEach(lang => {
                            const activeClass = (lang.code === currentLangCode) ? "active" : "";
                            const $item = $('<a>', {
                                class: `dropdown-item ${activeClass}`,
                                href: '#',
                                text: lang.name,
                                click: function (e) {
                                    e.preventDefault();
                                    changeLanguage(lang.code, lang.name);
                                }
                            });
                            $menu.append($('<li>').append($item));
                        });
                    }
                }
            });
        }

        function changeLanguage(langCode, langName) {
            const req = {
                LanguageCode: langCode,
                ReturnUrl: window.location.pathname + window.location.search
            };

            ajaxService.post('/Language/ChangeLanguage', req, {
                showLoading: false,
                onSuccess: function (res) {
                    if (res.isOk()) {
                        if (res.data && res.data.returnUrl) {
                            window.location.href = res.data.returnUrl;
                        } else {
                            location.reload();
                        }
                    } else {
                        showToast(res.message || "Không đổi được ngôn ngữ", "Thông báo", "error");
                    }
                }
            });
        }
    });
</script>
