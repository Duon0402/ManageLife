@{
    var currentLanguageCode = LanguageContext.GetCurrentLanguage();
    var currentLanguageName = await LanguageContext.GetCurrentLanguageNameAsync(currentLanguageCode);
    var displayName = UserContext.GetUserName() ?? "";
    var initials = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "?";
    var currentPath = Context.Request.Path.Value ?? "";
    var siteName = await SettingContext.GetStringAsync(SettingKeys.Site.Name) ?? "Manage Life";
    var logoUrl = await SettingContext.GetStringAsync(SettingKeys.Site.LogoUrl);
    var enableChat = await SettingContext.GetBoolAsync(SettingKeys.Feature.EnableChat, true);
    var enableVocab = await SettingContext.GetBoolAsync(SettingKeys.Feature.EnableVocab, true);
}

<header class="header" id="client-header">
    <input type="hidden" id="currentLangCode" value="@currentLanguageCode" />

    <div class="header__inner">
        <!-- Logo -->
        <div class="header__logo">
            <a href="/">
                @if (!string.IsNullOrEmpty(logoUrl))
                {
                    <img src="@logoUrl" alt="@siteName" style="height:32px;max-width:140px;object-fit:contain;" />
                }
                else
                {
                    <h3 class="brand">@siteName</h3>
                }
            </a>
        </div>

        <!-- Hamburger (mobile) -->
        <button class="header__toggle" id="header-toggle" type="button" aria-label="Toggle menu">
            <span class="header__toggle-bar"></span>
            <span class="header__toggle-bar"></span>
            <span class="header__toggle-bar"></span>
        </button>

        <!-- Nav -->
        <nav class="header__nav" id="header-nav">
            <ul class="nav">
                <li class="nav-item">
                    <a class="nav-link @(currentPath == "/" ? "active" : "")" href="/">
                        @T(TranslationKey.Client.Header.Menu.Home)
                    </a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle @(currentPath != "/" ? "active" : "")"
                       href="#" data-bs-toggle="dropdown">
                        @T(TranslationKey.Client.Header.Menu.Utility.Title)
                    </a>
                    <ul class="dropdown-menu header__dropdown">
                        <li>
                            <a class="dropdown-item @(currentPath.StartsWith("/Todo") ? "active" : "")" href="/Todo">
                                <i class="fa-solid fa-list-check me-2"></i>Công việc
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item @(currentPath.StartsWith("/Folder") ? "active" : "")" href="/Folder">
                                <i class="fa-solid fa-images me-2"></i>Photo Albums
                            </a>
                        </li>
                        @if (enableVocab)
                        {
                        <li>
                            <a class="dropdown-item @(currentPath.StartsWith("/Vocab") ? "active" : "")" href="/Vocab">
                                <i class="fa-solid fa-book-open me-2"></i>Từ vựng
                            </a>
                        </li>
                        }
                        <li>
                            <a class="dropdown-item @(currentPath.StartsWith("/Note") ? "active" : "")" href="/Note">
                                <i class="fa-solid fa-brain me-2"></i>Notes
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item @(currentPath.StartsWith("/Habit") ? "active" : "")" href="/Habit">
                                <i class="fa-solid fa-repeat me-2"></i>Thói quen
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item @(currentPath.StartsWith("/Pomodoro") ? "active" : "")" href="/Pomodoro">
                                <i class="fa-solid fa-clock me-2"></i>Pomodoro
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <a class="dropdown-item @(currentPath.StartsWith("/Utility/EmailDailyReport") ? "active" : "")"
                               href="/Utility/EmailDailyReport">
                                <i class="fa-solid fa-envelope me-2"></i>
                                @T(TranslationKey.Client.Header.Menu.Utility.EmailDailyReport)
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item @(currentPath.StartsWith("/VideoDownloader") ? "active" : "")"
                               href="/VideoDownloader">
                                <i class="fa-solid fa-download me-2"></i>
                                Video Downloader
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item @(currentPath.StartsWith("/ShortUrl") ? "active" : "")"
                               href="/ShortUrl">
                                <i class="fa-solid fa-link me-2"></i>
                                URL Shortener
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>

        <!-- Right: User + Language -->
        <div class="header__right" id="header-right">
            @if (displayName.IsNotEmpty())
            {
                <div class="dropdown header__user">
                    <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="header__user-avatar">@initials</div>
                        <span class="header__user-name">@displayName</span>
                        <i class="fa-solid fa-chevron-down header__user-caret"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="/Auth/ChangePassword">
                                <i class="fa-solid fa-key me-2"></i> Đổi mật khẩu
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <a class="dropdown-item text-danger" href="#" id="client-logout-btn">
                                <i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            }
            <div class="header__lang">
                <div class="dropdown">
                    <button id="currentLangBtn" class="header__lang-btn dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-globe me-1"></i> @currentLanguageName
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" id="languageMenu"></ul>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
    $(function () {
        new App.ClientHeader("#client-header");
    });
</script>
