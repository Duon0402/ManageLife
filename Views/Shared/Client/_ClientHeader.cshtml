@{
    var currentLanguageCode = LanguageContext.GetCurrentLanguage();
    var currentLanguageName = await LanguageContext.GetCurrentLanguageNameAsync(currentLanguageCode);
}

<header class="header d-flex justify-content-between align-items-center px-5" id="client-header">
    <div class="logo d-flex align-items-center">
        <a href="/">
            <h3 class="brand">Manage Life</h3>
        </a>
    </div>

    <nav class="nav-menu d-flex align-items-center">
        <ul class="nav">
            <li class="nav-item">
                <a class="nav-link px-3" href="/">@T(TranslationKey.Client.Header.Menu.Home)</a>
            </li>

            <li class="nav-item">
                <a class="nav-link px-3" href="/Album">Photo Albums</a>
            </li>

            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle px-3" href="#" data-bs-toggle="dropdown">
                    @T(TranslationKey.Client.Header.Menu.Utility.Title)
                </a>
                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" href="/Utility/EmailDailyReport">
                            @T(TranslationKey.Client.Header.Menu.Utility.EmailDailyReport)
                        </a>
                    </li>
                </ul>
            </li>
        </ul>
    </nav>

    <div class="language">
        <div class="dropdown">
            <button id="currentLangBtn" class="dropdown-toggle btn btn-light" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                @currentLanguageName
            </button>
            <ul class="dropdown-menu" id="languageMenu"></ul>
        </div>
    </div>
</header>

<input type="hidden" id="currentLangCode" value="@currentLanguageCode" />

<script>
    $(function () {
        new App.ClientHeader("#client-header");
    });
</script>
