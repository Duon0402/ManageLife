<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - ManageLife</title>

	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

	<link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/ManageLife.styles.css" asp-append-version="true" />

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>

	<div class="layout">
		<partial name="_Header" />

		<div class="d-flex flex-grow-1">
			<main class="content-container flex-grow-1 px-5 py-4">
				@RenderBody()
			</main>
		</div>
	</div>
	<script src="@Url.Content("~/lib/bootstrap/dist/js/bootstrap.bundle.min.js")"></script>
	<script src="@Url.Content("~/js/ajaxService.js")?v=1.0.2"></script>
	<script src="@Url.Content("~/js/toast.js")?v=1.0.0"></script>
	<script src="@Url.Content("~/js/loading.js")?v=1.0.0"></script>
	<script src="@Url.Content("~/js/site.js")?v=1.0.0"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
