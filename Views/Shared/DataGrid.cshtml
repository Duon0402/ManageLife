@model DataGridViewModel<object>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="table-primary">
            <tr>
                @foreach (var columnName in Model.ColumnNames)
                {
                    <th>@columnName</th>
                }
                @if (Model.Actions.Any())
                {
                    <th>Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    @foreach (var property in item.GetType().GetProperties())
                    {
                        <td>@property.GetValue(item, null)</td>
                    }
                    @if (Model.Actions.Any())
                    {
                        <td>
                            @foreach (var action in Model.Actions)
                            {
                                <button class="btn @action.CssClass me-2"
                                        onclick="@($"{action.OnClickFunction}('{item.GetType().GetProperty("ID")?.GetValue(item, null)}')")">
                                    @action.ButtonText
                                </button>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
