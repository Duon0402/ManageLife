@{
	ViewData["Title"] = "Wallet Management";
}
@model WalletViewModel;
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>@ViewData["Title"]</title>

	<!-- Include Bootstrap CSS -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />

	<!-- Include jQuery (for simplicity) -->
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

	<!-- Include Bootstrap JS -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
	<div class="container mt-5">
		<h1 class="mb-4">@ViewData["Title"]</h1>
		@{
			var gridOptions = new DataGridOptions();
			gridOptions.AllowInsert = true;
			gridOptions.Id = "wallet_data_grid";
			@(Html.DataGrid<WalletModel>(Model.Wallets, new List<string> { "Id", "Name", "Balance" }, gridOptions));
		}

		<div class="d-none">
			<!-- Get List Data Button -->
			<button id="btnGetList" class="btn btn-primary mb-3">Get Wallet List</button>

			<div id="walletList" class="mb-3">
				<!-- Wallet list will be displayed here -->
			</div>

			<!-- Get Data By ID Form -->
			<div class="mb-3">
				<h3>Get Wallet Data by ID</h3>
				<form id="getDataForm">
					<div class="input-group">
						<input type="text" id="walletId" class="form-control" placeholder="Enter Wallet ID" required />
						<button type="submit" class="btn btn-success">Get Data</button>
					</div>
				</form>
				<div id="walletData" class="mt-3">
					<!-- Wallet data will be displayed here -->
				</div>
			</div>

			<!-- Insert Wallet Form -->
			<div>
				<h3>Create New Wallet</h3>
				<form id="insertWalletForm">
					<div class="mb-3">
						<label for="walletName" class="form-label">Wallet Name</label>
						<input type="text" id="walletName" class="form-control" placeholder="Wallet Name" required />
					</div>
					<button type="submit" class="btn btn-primary">Create Wallet</button>
				</form>
			</div>
		</div>
	</div>

	<script>
		// Fetch wallet list
		$('#btnGetList').on('click', function () {
			$.get('/Wallet/GetListData', function (rs) {
				$('#walletList').html('');
				if (rs.code == "00" && rs.data && rs.data.length > 0) {
					const walletItems = rs.data.map(item => `
						<div class="card mb-2">
							<div class="card-body">
								<h5 class="card-title">${item.name}</h5>
								<p class="card-text">Wallet ID: ${item.id}</p>
							</div>
						</div>
					`);
					$('#walletList').html(walletItems.join(''));
				} else {
					$('#walletList').html('<p>No wallets found.</p>');
				}
			});
		});

		// Get wallet data by ID
		$('#getDataForm').on('submit', function (e) {
			e.preventDefault();
			const walletId = $('#walletId').val();
			$.get(`/Wallet/GetDataById?walletId=${walletId}`, function (rs) {
				$('#walletData').html('');
				if (rs.code == "00" && rs.data) {
					const walletInfo = `
						<div class="card">
							<div class="card-body">
								<h5 class="card-title">${rs.data.name}</h5>
								<p class="card-text">Wallet ID: ${rs.data.id}</p>
							</div>
						</div>
					`;
					$('#walletData').html(walletInfo);
				} else {
					$('#walletData').html('<p>No wallet found for the provided ID.</p>');
				}
			});
		});

		// Insert a new wallet
		$('#insertWalletForm').on('submit', function (e) {
			e.preventDefault();
			const walletName = $('#walletName').val();
			$.post('/Wallet/Insert', { name: walletName }, function (rs) {
				if (rs.code == "00") {
					alert('Wallet created successfully!');
					$('#walletName').val('');
				} else {
					alert('Failed to create wallet.');
				}
			});
		});

		function insertFunction() {
			console.log("Insert function");
		}
	</script>
</body>
</html>
